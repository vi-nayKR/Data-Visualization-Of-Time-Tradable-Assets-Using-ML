[Unit]
Description=Stock Market Dashboard FastAPI Backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vinay
Group=vinay
WorkingDirectory=/home/vinay/stock-market-dashboard/backend
Environment="PATH=/home/vinay/stock-market-dashboard/backend/.venv/bin:/usr/bin"
ExecStart=/home/vinay/stock-market-dashboard/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
